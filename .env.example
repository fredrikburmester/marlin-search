# Copy to .env and fill in. `docker compose up` reads this file automatically.

# --- Required ---

# Base URL of your Jellyfin server, reachable from the Marlin container.
JELLYFIN_URL=http://jellyfin.example.com:8096

# Jellyfin API key (Dashboard -> Advanced -> API Keys).
JELLYFIN_API_KEY=

# Meilisearch master key. Must be at least 16 bytes.
# Generate one with: openssl rand -hex 32
MEILISEARCH_API_KEY=

# Guards /create-index, /clear-index and /delete-index.
# Without it those routes are disabled and return 503.
# Generate one with: openssl rand -hex 32
EXPRESS_AUTH_TOKEN=

# --- Optional ---

# Guards /search. Leave empty to keep /search public.
SEARCH_AUTH_TOKEN=

# Guards /webhook. Defaults to EXPRESS_AUTH_TOKEN when empty.
WEBHOOK_AUTH_TOKEN=

# How often the full library re-scrape runs.
SCRAPE_INTERVAL_MINUTES=60

# Items fetched from Jellyfin per request.
BATCH_SIZE=1000

# Default number of hits /search returns when `limit` is not supplied.
SEARCH_LIMIT=50

# Host port Marlin is published on.
MARLIN_PORT=5000

# error | warn | info | debug
LOG_LEVEL=info
