{
  "name": "marlin-search",
  "description": "A Jellyfin search companion backed by Meilisearch",
  "private": true,
  "main": "build/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "meilisearch": "^0.63.0",
    "winston": "^3.19.0"
  }
}
